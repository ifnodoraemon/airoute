  "rules": [
    {
      "pattern": "(^|/)deepseek-v4[.-]1",
      "provider": "vllm|gpustack",
      "profile": "vllm-deepseek41"
    },
    {
      "pattern": "(^|/)glm-5[.-]3",
      "provider": "openai|custom",
      "profile": "glm53"
    },
    {
      "pattern": "(^|/)gemini-2\\.5-pro",
      "profile": "gemini-budget-required",
      "provider": "gemini|vertex"
    },
    {
      "pattern": "(^|/)gemini-2\\.5-flash",
      "profile": "gemini-budget",
      "provider": "gemini|vertex"
    },
    {
      "pattern": "(^|/)gemini-3-pro",
      "profile": "gemini-3-pro",
      "provider": "gemini|vertex"
    },
    {
      "pattern": "(^|/)gemini-3-flash|(^|/)gemini-3\\.[156]-flash",
      "profile": "gemini-minimal",
      "provider": "gemini|vertex"
    },
    {
      "pattern": "(^|/)gemini-3\\.(1-pro|8-flash)|(^|/)gemini-4-argon",
      "profile": "gemini-levels",
      "provider": "gemini|vertex"
    },
    {
      "pattern": "(^|/)gemma-4",
      "provider": "gemini|vertex",
      "profile": "gemma"
    },
    {
      "pattern": "(^|/)deepseek-(v4|flash)",
      "profile": "deepseek",
      "provider": "deepseek"
    },
    {
      "pattern": "qwen.*(thinking|reasoner)",
      "profile": "qwen-required-toggle",
      "provider": "openai|custom"
    },
    {
      "pattern": "qwen3",
      "provider": "vllm|sglang",
      "profile": "vllm-qwen"
    },
    {
      "pattern": "(^|/)qwen3-(\\d+b|\\d+b-a\\d+b)($|-)",
      "profile": "qwen-toggle",
      "provider": "openai|custom"
    },
    {
      "pattern": "(^|/)gpt-6\\.1-sol|(^|/)gpt-6-astra",
      "profile": "openai-max-required"
    },
    {
      "pattern": "(^|/)gpt-6-(sol|luna)",
      "profile": "openai-max"
    },
    {
      "pattern": "(^|/)gpt-5\\.[2-5]",
      "profile": "openai-xhigh"
    },
    {
      "pattern": "(^|/)gpt-5\\.1",
      "profile": "openai-toggle"
    },
    {
      "pattern": "(^|/)gpt-5($|[-/])",
      "profile": "openai-gpt5"
    },
    {
      "pattern": "(^|/)o[134]($|[-/])",
      "profile": "openai-required"
    },
    {
      "pattern": "(^|/)claude-(mythos|fable)",
      "profile": "claude-always",
      "provider": "anthropic"
    },
    {
      "pattern": "(^|/)claude-.*4[-.]([678])|(^|/)claude-(sonnet|opus)-5",
      "profile": "claude-adaptive",
      "provider": "anthropic"
    },
    {
      "pattern": "(^|/)claude-.*4",
      "profile": "claude-budget",
      "provider": "anthropic"
    },
    {
      "pattern": "(^|/)gemini-.*-latest$",
      "provider": "gemini|vertex",
      "profile": "gemini-summary"
    }
  ]
}

# ==============================================================================
# Airoute 全局统一环境配置模板 (Single Source of Truth)
# 本文件同时作为本地开发运行与 Docker Compose 集群部署的唯一配置源
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 基础服务与时区 (Server & Timezone)
# ------------------------------------------------------------------------------
TZ=Asia/Shanghai
GATEWAY_PORT=8080
GATEWAY_HOST=0.0.0.0
# YAML 配置文件路径（等价于 -config 参数）。文件不存在时进程直接失败，不再静默回退默认配置。
GATEWAY_CONFIG=configs/config.yaml
# SQLite 数据库路径（等价于 -db 参数）；设置 DATABASE_URL 时改用 PostgreSQL。
GATEWAY_DB_DSN=
# 负载均衡对外暴露端口 (可选，默认跟随 GATEWAY_PORT 或 8080)
GATEWAY_INGRESS_PORT=8080
# 外部网关公开访问基础 URL (可选，留空则自动按客户端请求 Host 与反向代理协议头动态计算)
PUBLIC_URL=
GATEWAY_PUBLIC_URL=
# 发布模式：Compose/Swarm 默认 release（影响 gin 与生产环境告警）
GIN_MODE=release
# 启动凭证门禁默认拒绝弱凭证（占位 secret / admin123 / 短密码）。
# 仅在一次性本地开发环境可设为 true；生产环境绝不能开启。
GATEWAY_ALLOW_INSECURE_DEFAULTS=false
# /metrics 访问令牌（可选）。设置后抓取需要 Authorization: Bearer <token>；
# 未设置时 /metrics 仅允许 loopback/私网客户端访问（Prometheus 侧车/Compose 可直接抓取）。
GATEWAY_METRICS_TOKEN=
# 显式允许公网抓取 /metrics（不推荐；仅在令牌或私网方案不可行时使用）。
GATEWAY_METRICS_ALLOW_PUBLIC=false
# 可信反向代理 CIDR（逗号分隔）。只有来自这些地址的 X-Forwarded-For 会被采信；
# 留空表示不信任任何转发头（按代理地址统计限流）。Docker Compose 默认网段 172.22.0.0/16。
GATEWAY_TRUSTED_PROXIES=
# D15 控制面访问控制：/api/v1/admin 与 /app 默认仅允许 loopback/私网客户端访问。
# 显式 CIDR 列表（逗号分隔）会覆盖默认；留空使用默认。
GATEWAY_ADMIN_ALLOWED_IPS=
# 可选 Host 白名单（逗号分隔，支持 *.example.com）；留空不校验 Host。
GATEWAY_ADMIN_ALLOWED_HOSTS=
# 显式放开控制面给公网（不推荐；仅在有其它边界防护时使用）。
GATEWAY_ADMIN_ALLOW_PUBLIC=false

# ------------------------------------------------------------------------------
# 2. 管理员与系统主控密钥 (Admin Credentials & Cluster Secret)
# ------------------------------------------------------------------------------
GATEWAY_ADMIN_USER=admin
# GATEWAY_ADMIN_USER 的旧别名（仅在 GATEWAY_ADMIN_USER 为空时生效）
GATEWAY_ADMIN_USERNAME=
# 必须为强随机值（密码 >= 16 字符，签名密钥 >= 32 字符）。
# 弱值或仓库公开占位值会让进程直接拒绝启动。
GATEWAY_ADMIN_PASSWORD=
GATEWAY_ADMIN_SECRET=
# 一次性逃生开关：设为 true 时下次启动会把已存库的管理员密码强制重置为
# GATEWAY_ADMIN_PASSWORD，随后请改回 false（否则每次重启都会重置）。
GATEWAY_ADMIN_RESET=false

# ------------------------------------------------------------------------------
# 3. 用户认证与额度策略 (Auth & Governance)
# ------------------------------------------------------------------------------
# 自主注册默认关闭；开放时请配合 REQUIRE_EMAIL_VERIFICATION 与限流。
ALLOW_REGISTRATION=false
# 注册赠送额度：0 = 不赠送（默认）。需要试用额度时显式改为正数。
INITIAL_USER_BALANCE=0.0
# 开放注册时应保持 true，避免批量注册后立即消耗试用额度。
REQUIRE_EMAIL_VERIFICATION=true
TOKEN_EXPIRY_HOURS=168

# ------------------------------------------------------------------------------
# 4. 共享关系型数据库 (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_USER=airoute
POSTGRES_PASSWORD=
POSTGRES_DB=airoute
DATABASE_URL=

# ------------------------------------------------------------------------------
# 5. 分布式缓存与事件总线 (Redis 7)
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 6. 对象存储服务 (Airoute Storage / S3 / RustFS)
# ------------------------------------------------------------------------------
STORAGE_DRIVER=s3
# driver=local 时的落盘目录
STORAGE_LOCAL_PATH=data/storage
STORAGE_S3_ENDPOINT=http://storage:9000
STORAGE_S3_BUCKET=airoute-skills
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_USE_SSL=false
STORAGE_S3_PATH_STYLE=true
STORAGE_S3_PUBLIC_URL_PREFIX=

# ------------------------------------------------------------------------------
# 7. 请求链路快照（排障用，默认只记录失败请求，脱敏后保存）
# ------------------------------------------------------------------------------
# off | errors | all
GATEWAY_TRACE_CAPTURE=errors
GATEWAY_TRACE_SAMPLE=100
GATEWAY_TRACE_TTL_HOURS=72
GATEWAY_TRACE_MAX_SNIPPET=4096
GATEWAY_MAX_BODY_BYTES=67108864

# PostgreSQL 连接池预算（每个副本独立计算）。集群总连接数 =
# GATEWAY_DB_MAX_OPEN_CONNS × 副本数，必须小于服务端 max_connections（默认 200）。
GATEWAY_DB_MAX_OPEN_CONNS=25
GATEWAY_DB_MAX_IDLE_CONNS=8

# 计费与审计管道
# 钱包允许的最大透支额（元）。0 = 不允许透支；负余额会被钳制在该额度内并计入
# airoute_billing_overdrafts_total。
GATEWAY_MAX_OVERDRAFT_CNY=1.0
# 计费流水磁盘兜底目录（Redis/内存/数据库都不可用时写入，启动时重放）。
# 设为 - 可禁用（不推荐：禁用意味着极端情况下会丢计费记录）。
GATEWAY_USAGE_SPILL_DIR=data
GATEWAY_USAGE_SPILL_MAX_MB=256
# 多副本共享 spill 目录时，一条记录被某副本认领后其他副本的等待宽限（秒）。
GATEWAY_USAGE_SPILL_CLAIM_GRACE_SEC=600
# 账本对账周期（小时），0 = 关闭。定期比对 key 账本/审计流水/余额镜像并在
# /metrics 暴露漂移。
GATEWAY_BILLING_RECONCILE_HOURS=6
# 无 moderation 渠道时 /v1/moderations 返回 501；置 true 才返回本地伪造的
# "全部安全"响应（仅限联调）。
GATEWAY_MODERATION_STUB=false
# 审计与用量日志保留天数（0 = 永久保留）及清理周期（小时）——
# 不配置时 usage_logs 会无限增长。
GATEWAY_USAGE_LOG_RETENTION_DAYS=365
GATEWAY_USAGE_LOG_PRUNE_INTERVAL_HOURS=6
# 邮箱验证码 / 视频任务保留天数（0 = 永久保留）。
GATEWAY_VERIFICATION_RETENTION_DAYS=7
GATEWAY_VIDEO_TASK_RETENTION_DAYS=30
# 仪表盘 TTFT 分位数采样上限（行数）；越大越准、查询越重。
GATEWAY_TIMESERIES_TTFT_SAMPLE=5000

# ------------------------------------------------------------------------------
# 8. 网关运行时调优 (Runtime Tuning)
# ------------------------------------------------------------------------------
# 首 token 等待上限（秒）。留空 = 由渠道 timeout 派生；渠道未配置 timeout 时
# 默认 30s（推理模型 o1/o3/r1/thinking 为 60s）。显式设置只影响未配置 timeout 的渠道。
GATEWAY_FIRST_TOKEN_TIMEOUT=
# 三态熔断器。默认开启；单渠道部署建议 false，只记录不拦截（advisory）。
# 注意：429 不计入渠道故障，直接透传退避。
GATEWAY_BREAKER_ENABLED=true
GATEWAY_BREAKER_FAILURES=3
GATEWAY_BREAKER_COOLDOWN_SEC=30
# 客户端断开后继续排空上游，用上游真实 usage 计费。false = 立即取消 + 估算（省钱模式）。
GATEWAY_DRAIN_ABORTED_UPSTREAM=true
GATEWAY_DRAIN_TIMEOUT_SEC=120
# 非流式请求总预算（秒）：跨渠道尝试与跨模型兜底共享；0 表示关闭。默认 300。
# 流式请求不使用总预算，仍由渠道超时与首字超时约束。
GATEWAY_REQUEST_BUDGET_SEC=300
# SIGTERM 后的排空预算（秒）。留空 = 由 GATEWAY_DRAIN_TIMEOUT_SEC 派生（+15s 审计落盘余量，
# 默认 135s）；必须小于容器 stop_grace_period / K8s terminationGracePeriodSeconds。
GATEWAY_SHUTDOWN_TIMEOUT_SEC=135
# 公开状态页是否暴露模型目录。
GATEWAY_PUBLIC_STATUS=true
# 探活安全：禁止探测内网 / 回环地址（默认 false）。
GATEWAY_BLOCK_PRIVATE_PROBE=false
GATEWAY_BLOCK_LOOPBACK_PROBE=false
# 未配置 fixed_price 的多模态模型默认拒绝（422 pricing_not_configured）；
# 设为 1 才允许零价转发（仅限明确要免费提供时）。
GATEWAY_ALLOW_UNPRICED_MULTIMODAL=0

# ------------------------------------------------------------------------------
# 9. 可选集成 (Optional Integrations)
# ------------------------------------------------------------------------------
# 邮件验证码 / 找回密码（SMTP_HOST 为空时邮件功能关闭）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Stripe 支付（未配置时 webhook 被拒绝、充值入口隐藏）
# 预算阈值告警（可选）：通用 Webhook / 钉钉 / 飞书 / 企业微信机器人；邮件复用上方 SMTP_*。
GATEWAY_ALERT_WEBHOOK_URL=
GATEWAY_ALERT_DINGTALK_URL=
GATEWAY_ALERT_FEISHU_URL=
GATEWAY_ALERT_WECOM_URL=
GATEWAY_ALERT_EMAIL_TO=

STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=
STRIPE_API_BASE=
# OAuth 登录（GitHub / Google）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 沙箱充值 / 模拟 OAuth：仅本地联调，生产必须保持 false
ENABLE_SANDBOX_RECHARGE=false
ENABLE_SIMULATED_OAUTH=false
# 在 API 响应中返回邮箱验证码（仅本地联调）
AIROUTE_DEV_VERIFICATION_CODE=false
# 注册赠送额度；INITIAL_USER_BALANCE 的旧别名（仅在其为空时生效）
DEFAULT_TRIAL_BALANCE=

# ------------------------------------------------------------------------------
# 10. CLI 客户端变量 (CLI only)
# ------------------------------------------------------------------------------
# 仅 airoute status/models/keys/users/skills/mcp/chat 读取；服务端不使用。
# AIROUTE_ENDPOINT 留空时按 PUBLIC_URL / GATEWAY_HOST:PORT 自动推导。
AIROUTE_ENDPOINT=
# chat 需要虚拟 API Key；keys/users/skills/mcp 需要管理员 Token。
AIROUTE_TOKEN=

# ==============================================================================
# Airoute 全局统一环境配置模板 (Single Source of Truth)
# 本文件同时作为本地开发运行与 Docker Compose 集群部署的唯一配置源
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 基础服务与时区 (Server & Timezone)
# ------------------------------------------------------------------------------
TZ=Asia/Shanghai
GATEWAY_PORT=8080
GATEWAY_HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 2. 管理员与系统主控密钥 (Admin Credentials & Cluster Secret)
# ------------------------------------------------------------------------------
GATEWAY_ADMIN_USER=admin
GATEWAY_ADMIN_PASSWORD=admin123
GATEWAY_ADMIN_SECRET=airoute-cluster-admin-shared-secret-key-32b

# ------------------------------------------------------------------------------
# 3. 用户认证与额度策略 (Auth & Governance)
# ------------------------------------------------------------------------------
ALLOW_REGISTRATION=true
INITIAL_USER_BALANCE=5.0
REQUIRE_EMAIL_VERIFICATION=false
TOKEN_EXPIRY_HOURS=168

# ------------------------------------------------------------------------------
# 4. 共享关系型数据库 (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_USER=airoute
POSTGRES_PASSWORD=airoute_cluster_secret_pass_2026
POSTGRES_DB=airoute
DATABASE_URL=postgres://airoute:airoute_cluster_secret_pass_2026@postgres:5432/airoute?sslmode=disable

# ------------------------------------------------------------------------------
# 5. 分布式缓存与事件总线 (Redis 7)
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 6. 对象存储服务 (Airoute Storage / S3 / RustFS)
# ------------------------------------------------------------------------------
STORAGE_DRIVER=s3
STORAGE_S3_ENDPOINT=http://storage:9000
STORAGE_S3_BUCKET=airoute-skills
STORAGE_S3_ACCESS_KEY=airoute
STORAGE_S3_SECRET_KEY=airoute_cluster_secret_pass_2026
STORAGE_S3_REGION=us-east-1
STORAGE_S3_USE_SSL=false
STORAGE_S3_PATH_STYLE=true
STORAGE_S3_PUBLIC_URL_PREFIX=

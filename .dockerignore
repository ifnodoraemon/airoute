web/node_modules
# Build artifact, rebuilt inside the image; the go-builder stage copies it from
# the web-builder stage rather than from the build context.
web/dist
bin/
data/
.git
# Secrets must never enter the build context. `.env` holds the admin password,
# the signing secret and the database/Redis/S3 credentials, and a BuildKit cache
# export or a misconfigured COPY would otherwise ship them.
.env
.env.*
!.env.example
*.local
# Not needed by any stage; keeping them out shrinks the context and avoids
# accidentally copying docs/tests into the image.
docs/
tests/
helm/
deploy/
scripts/
.github/
*.test
coverage.out
